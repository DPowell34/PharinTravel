<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Destined 4 Destinations — Owner Dashboard</title>
<script src="auth-guard.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<style>
  :root {
    --teal: #1fa3c9; --teal-dark: #0b3d6b; --gold: #c9973f;
    --bg: #f6f5f1; --ink: #1f2937; --muted: #6b7280; --border: #e5e7eb;
    --green: #16a34a; --red: #dc2626;
    --sidebar-w: 232px;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg); color: var(--ink);
  }

  /* ---- Sidebar ---- */
  .sidebar {
    position: fixed; top: 0; left: 0; bottom: 0; width: var(--sidebar-w);
    background: var(--teal-dark); color: white; display: flex; flex-direction: column;
    padding: 20px 0; overflow-y: auto;
  }
  .brand { display: flex; align-items: center; gap: 10px; padding: 0 20px 20px; }
  .brand-badge {
    width: 38px; height: 38px; border-radius: 50%; background: var(--teal);
    display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.8rem;
    flex-shrink: 0;
  }
  .brand-name { font-weight: 700; font-size: 0.95rem; line-height: 1.2; }
  .brand-name span { color: var(--gold); }

  nav.side-nav { display: flex; flex-direction: column; gap: 2px; padding: 8px 12px; }
  .nav-item {
    display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 8px;
    color: rgba(255,255,255,0.82); text-decoration: none; font-size: 0.88rem; font-weight: 600;
    cursor: pointer; border: none; background: none; width: 100%; text-align: left;
  }
  .nav-item:hover { background: rgba(255,255,255,0.08); color: white; }
  .nav-item.active { background: var(--teal); color: white; }
  .nav-item .icon { width: 18px; text-align: center; opacity: 0.9; }
  .nav-item.soon { cursor: default; opacity: 0.55; }
  .nav-item.soon:hover { background: none; color: rgba(255,255,255,0.82); }
  .nav-item .tag {
    margin-left: auto; font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.04em;
    background: rgba(255,255,255,0.14); padding: 2px 6px; border-radius: 999px;
  }
  .nav-divider { height: 1px; background: rgba(255,255,255,0.12); margin: 10px 20px; }

  .sidebar-footer { margin-top: auto; padding: 14px 20px 4px; border-top: 1px solid rgba(255,255,255,0.12); }
  .profile-card { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .profile-avatar {
    width: 34px; height: 34px; border-radius: 50%; background: var(--gold); color: white;
    display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem;
  }
  .profile-name { font-size: 0.82rem; font-weight: 700; }
  .profile-role { font-size: 0.72rem; color: rgba(255,255,255,0.65); }
  .sidebar-footer a {
    display: block; color: rgba(255,255,255,0.85); font-size: 0.8rem; text-decoration: none;
    padding: 6px 0;
  }
  .sidebar-footer a:hover { color: white; text-decoration: underline; }

  /* ---- Main ---- */
  .main { margin-left: var(--sidebar-w); padding: 26px 32px 60px; max-width: 1200px; }
  .topbar { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 22px; flex-wrap: wrap; gap: 10px; }
  .topbar h1 { margin: 0 0 4px; font-size: 1.5rem; }
  .topbar .subtitle { color: var(--muted); font-size: 0.9rem; }
  .status { font-size: 0.82rem; color: var(--muted); background: white; border: 1px solid var(--border); padding: 8px 14px; border-radius: 999px; }

  .panel { display: none; }
  .panel.active { display: block; }

  .card {
    background: white; border: 1px solid var(--border); border-radius: 14px; padding: 20px 22px; margin-bottom: 20px;
  }
  .card-title { font-weight: 700; font-size: 0.98rem; margin-bottom: 14px; }
  .card-title .link { float: right; font-weight: 600; font-size: 0.8rem; color: var(--teal); text-decoration: none; }

  .stat-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 20px; }
  @media (max-width: 900px) { .stat-grid { grid-template-columns: repeat(2, 1fr); } }
  .stat-card { background: white; border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; }
  .stat-label { font-size: 0.78rem; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 8px; }
  .stat-value { font-size: 1.65rem; font-weight: 800; color: var(--teal-dark); }
  .stat-delta { font-size: 0.8rem; margin-top: 6px; font-weight: 600; }
  .stat-delta.up { color: var(--green); }
  .stat-delta.down { color: var(--red); }
  .stat-delta.neutral { color: var(--muted); }

  .dash-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 20px; }
  @media (max-width: 900px) { .dash-grid { grid-template-columns: 1fr; } }

  .list { list-style: none; margin: 0; padding: 0; }
  .list li { display: flex; justify-content: space-between; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--border); }
  .list li:last-child { border-bottom: none; }
  .list .item-main { font-weight: 600; font-size: 0.88rem; }
  .list .item-sub { color: var(--muted); font-size: 0.78rem; margin-top: 2px; }
  .list .item-meta { font-size: 0.8rem; font-weight: 700; color: var(--teal-dark); white-space: nowrap; text-align: right; }
  .list .item-meta small { display: block; font-weight: 500; color: var(--muted); font-size: 0.72rem; }
  .list .empty, .list .error { color: var(--muted); padding: 16px 0; text-align: center; font-size: 0.85rem; }
  .list .error { color: #b91c1c; }

  .donut-total { text-align: center; margin-top: 10px; font-size: 0.85rem; color: var(--muted); }
  .donut-total strong { display: block; font-size: 1.2rem; color: var(--teal-dark); }
  .legend-row { display: flex; gap: 14px; justify-content: center; margin-top: 10px; flex-wrap: wrap; }
  .legend-row span { font-size: 0.76rem; color: var(--muted); display: flex; align-items: center; gap: 5px; }
  .legend-dot { width: 9px; height: 9px; border-radius: 50%; display: inline-block; }

  table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  th, td { text-align: left; padding: 12px 14px; border-bottom: 1px solid var(--border); }
  th { background: #fafaf9; color: var(--muted); font-weight: 600; font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.03em; }
  tr:last-child td { border-bottom: none; }
  tr:hover td { background: #fbfbfa; }

  .badge { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 0.74rem; font-weight: 600; }
  .badge.inquiry { background: #f3f4f6; color: #4b5563; }
  .badge.quoted { background: #fef3c7; color: #92400e; }
  .badge.booked { background: #dbeafe; color: #1e40af; }
  .badge.deposit-paid { background: #fed7aa; color: #9a3412; }
  .badge.paid-in-full { background: #ede9fe; color: #5b21b6; }
  .badge.traveled { background: #d1fae5; color: #065f46; }
  .badge.completed { background: #e7e5e4; color: #44403c; }
  .badge.cancelled { background: #fee2e2; color: #991b1b; }
  .badge.cat-airline { background:#e0e7ff; color:#3730a3; }
  .badge.cat-hotel { background:#fef3c7; color:#92400e; }
  .badge.cat-cruise-line { background:#dbeafe; color:#1e40af; }
  .badge.cat-tour-operator { background:#d1fae5; color:#065f46; }
  .badge.cat-car-rental { background:#fee2e2; color:#991b1b; }
  .badge.cat-insurance { background:#ede9fe; color:#5b21b6; }
  .badge.cat-ground-operator-dmc { background:#e7e5e4; color:#44403c; }
  .badge.cat-other { background:#f3f4f6; color:#4b5563; }
  .sup-toolbar { display:flex; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:16px; }
  .sup-toolbar input, .sup-toolbar select { padding:8px 12px; border:1px solid var(--border); border-radius:8px; font-size:0.85rem; }
  .sup-toolbar input { min-width:220px; }
  .sup-row { display:flex; align-items:center; gap:10px; }
  .sup-avatar {
    width:34px; height:34px; border-radius:50%; background:var(--teal-dark); color:white;
    display:flex; align-items:center; justify-content:center; font-size:1rem; flex-shrink:0;
  }
  .sup-name { font-weight:700; }
  .sup-stats-row { display:grid; grid-template-columns:repeat(4, 1fr); gap:16px; margin-top:18px; }
  .sup-outstanding { color:#b45309; font-weight:700; }
  @media (max-width: 900px) { .sup-stats-row { grid-template-columns:repeat(2, 1fr); } }
  .trip-cat-filters { display:flex; gap:6px; flex-wrap:wrap; margin: 4px 0 16px; }
  .cat-chip {
    background:white; border:1px solid var(--border); color:var(--muted); padding:6px 14px;
    border-radius:999px; font-size:0.8rem; font-weight:600; cursor:pointer;
  }
  .cat-chip:hover { border-color: var(--teal); color: var(--teal-dark); }
  .cat-chip.active { background: var(--teal-dark); border-color: var(--teal-dark); color:white; }

  .empty-cell, .error-cell { padding: 30px 20px; text-align: center; color: var(--muted); }
  .error-cell { color: #b91c1c; }

  .settings { display: flex; gap: 12px; flex-wrap: wrap; align-items: end; }
  .settings label { display: block; font-size: 0.8rem; color: var(--muted); margin-bottom: 4px; }
  .settings input { padding: 9px 10px; border: 1px solid var(--border); border-radius: 8px; width: 280px; font-size: 0.9rem; }
  .settings button {
    background: var(--teal); color: white; border: none; padding: 10px 18px;
    border-radius: 8px; font-weight: 600; cursor: pointer;
  }
  .settings button:hover { background: var(--teal-dark); }

  .task-form { display: flex; gap: 10px; flex-wrap: wrap; align-items: end; margin-bottom: 18px; }
  .task-form label { display: block; font-size: 0.78rem; color: var(--muted); margin-bottom: 4px; }
  .task-form input { padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; font-size: 0.85rem; }
  .task-form button { background: var(--teal); color: white; border: none; padding: 9px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; }
  .task-row { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--border); }
  .task-row:last-child { border-bottom: none; }
  .task-row input[type="checkbox"] { width: 17px; height: 17px; }
  .task-row .task-title { font-weight: 600; font-size: 0.88rem; flex: 1; }
  .task-row .task-title.done { text-decoration: line-through; color: var(--muted); }
  .task-row .task-meta { font-size: 0.78rem; color: var(--muted); }
  .banner-note { font-size: 0.8rem; color: var(--muted); background: #fafaf9; border: 1px dashed var(--border); border-radius: 10px; padding: 12px 14px; margin-bottom: 16px; }

  /* ---- Templates panel ---- */
  .tpl-tabs { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:18px; }
  .tpl-tab { background:white; border:1px solid var(--border); color:var(--muted); padding:8px 14px; border-radius:999px; font-size:0.82rem; font-weight:600; cursor:pointer; }
  .tpl-tab:hover { border-color: var(--teal); color: var(--teal-dark); }
  .tpl-tab.active { background: var(--teal-dark); border-color: var(--teal-dark); color:white; }
  .tpl-section { display:none; }
  .tpl-section.active { display:block; }
  .tpl-block { background:white; border:1px solid var(--border); border-radius:12px; padding:16px 18px; margin-bottom:14px; }
  .tpl-block-head { display:flex; justify-content:space-between; align-items:center; gap:10px; margin-bottom:8px; flex-wrap:wrap; }
  .tpl-block-title { font-weight:700; font-size:0.92rem; }
  .tpl-block-meta { font-size:0.76rem; color:var(--muted); font-weight:500; }
  .tpl-copy-btn { background:var(--teal); color:white; border:none; padding:6px 12px; border-radius:7px; font-size:0.76rem; font-weight:600; cursor:pointer; flex-shrink:0; }
  .tpl-copy-btn:hover { background:var(--teal-dark); }
  .tpl-body { font-size:0.85rem; line-height:1.55; color:var(--ink); white-space:pre-wrap; }
  .tpl-subject { font-size:0.8rem; color:var(--muted); margin-bottom:6px; }
  .tpl-subject strong { color:var(--ink); }
  .tpl-ref-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:6px 20px; }
  @media (max-width:900px) { .tpl-ref-grid { grid-template-columns:1fr; } }
  .tpl-ref-grid div { font-size:0.83rem; padding:6px 0; border-bottom:1px dashed var(--border); }
  .tpl-note { font-size:0.8rem; color:var(--muted); margin-bottom:14px; }

  /* ---- Reports panel ---- */
  .rpt-filters { display:flex; gap:16px; align-items:flex-end; flex-wrap:wrap; margin-bottom:16px; }
  .rpt-filters label { display:block; font-size:0.78rem; color:var(--muted); font-weight:600; margin-bottom:4px; }
  .rpt-filters select { padding:8px 10px; border:1px solid var(--border); border-radius:8px; font-size:0.85rem; min-width:140px; }
  .rpt-tabs { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:18px; }
  .rpt-tab { background:white; border:1px solid var(--border); color:var(--muted); padding:8px 14px; border-radius:999px; font-size:0.82rem; font-weight:600; cursor:pointer; }
  .rpt-tab:hover { border-color: var(--teal); color: var(--teal-dark); }
  .rpt-tab.active { background: var(--teal-dark); border-color: var(--teal-dark); color:white; }
  .rpt-section { display:none; }
  .rpt-section.active { display:block; }
  .rpt-table-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:8px; }
  .rpt-export-btn { background:white; border:1px solid var(--border); color:var(--teal-dark); padding:7px 14px; border-radius:7px; font-size:0.78rem; font-weight:600; cursor:pointer; }
  .rpt-export-btn:hover { background:#f3f8f7; }
  .rpt-delta { font-size:0.8rem; margin-top:6px; font-weight:600; min-height:1em; }
  .rpt-delta.up { color: var(--green); }
  .rpt-delta.down { color: var(--red); }
  .rpt-delta.neutral { color: var(--muted); }
  tfoot td { font-weight:800; border-top:2px solid var(--border); background:#fafaf9; }

  /* ---- Mobile responsive ---- */
  .card { overflow-x: auto; }
  .mobile-menu-btn {
    display: none; background: var(--teal-dark); color: white; border: none;
    width: 40px; height: 40px; border-radius: 8px; font-size: 1.3rem; cursor: pointer;
    align-items: center; justify-content: center; flex-shrink: 0;
  }
  .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(11,61,107,0.45); z-index: 40; }
  .sidebar-overlay.show { display: block; }
  @media (max-width: 860px) {
    .sidebar {
      transform: translateX(-100%); transition: transform 0.25s ease; z-index: 50;
      box-shadow: 4px 0 24px rgba(0,0,0,0.25);
    }
    .sidebar.open { transform: translateX(0); }
    .main { margin-left: 0; padding: 18px 16px 70px; }
    .mobile-menu-btn { display: flex; }
    .topbar h1 { font-size: 1.3rem; }
    .card { padding: 16px; }
    .stat-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }
  @media (max-width: 480px) {
    .stat-grid { grid-template-columns: 1fr; }
    .stat-value { font-size: 1.35rem; }
    .topbar h1 { font-size: 1.15rem; }
  }

  /* ---- Marketing panel ---- */
  .mkt-tabs { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:18px; }
  .mkt-tab { background:white; border:1px solid var(--border); color:var(--muted); padding:8px 14px; border-radius:999px; font-size:0.82rem; font-weight:600; cursor:pointer; }
  .mkt-tab:hover { border-color: var(--teal); color: var(--teal-dark); }
  .mkt-tab.active { background: var(--teal-dark); border-color: var(--teal-dark); color:white; }
  .mkt-section { display:none; }
  .mkt-section.active { display:block; }
  .mkt-tab .tag {
    margin-left: 6px; font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.04em;
    background: rgba(11,61,107,0.10); color: var(--teal-dark); padding: 2px 6px; border-radius: 999px;
  }
  .mkt-tab.active .tag { background: rgba(255,255,255,0.25); color: white; }
  .badge.mkt-expired { background:#fee2e2; color:#991b1b; }
  .cal-grid { display:grid; grid-template-columns: repeat(6, 1fr); gap:8px; }
  .cal-cell { border:1px solid var(--border); border-radius:8px; padding:8px; min-height:88px; background:#fafafa; }
  .cal-cell.today { border-color: var(--teal-dark); border-width:2px; background:white; }
  .cal-date { font-weight:700; color:var(--muted); margin-bottom:6px; font-size:0.66rem; text-transform:uppercase; letter-spacing:0.02em; }
  .cal-event { padding:2px 6px; border-radius:6px; margin-bottom:3px; font-size:0.68rem; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .cal-event.cal-bday { background: rgba(37,99,235,0.14); color:#1d4ed8; }
  .cal-event.cal-anniv { background: rgba(220,38,38,0.14); color:#b91c1c; }
  .cal-dot { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; }
  .cal-dot-bday { background:#1d4ed8; }
  .cal-dot-anniv { background:#b91c1c; }
  @media (max-width: 900px) { .cal-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .cal-grid { grid-template-columns: repeat(2, 1fr); } }
  .badge.mkt-soon { background:#fef3c7; color:#92400e; }
  .badge.mkt-ok { background:#d1fae5; color:#065f46; }
.profile-modal-overlay { display:none; position:fixed; inset:0; background:rgba(15,23,42,0.55); z-index:200; align-items:center; justify-content:center; padding:20px; }
  .profile-modal-overlay.show { display:flex; }
  .profile-modal { background:#fff; border-radius:12px; max-width:480px; width:100%; max-height:85vh; overflow-y:auto; padding:24px; box-shadow:0 20px 60px rgba(0,0,0,0.25); }
  .profile-modal-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; }
  .profile-modal-head h3 { margin:0; font-size:1.05rem; }
  .profile-modal-close { border:none; background:none; font-size:1.5rem; cursor:pointer; color:var(--muted); line-height:1; padding:0 4px; }
  .profile-modal-row { display:flex; justify-content:space-between; gap:14px; padding:8px 0; border-bottom:1px solid var(--border); font-size:0.84rem; }
  .profile-modal-row:last-child { border-bottom:none; }
  .profile-modal-row .label { color:var(--muted); flex-shrink:0; }
  .profile-modal-row .value { text-align:right; }
  .view-profile-btn { border:1px solid var(--border); background:#fff; border-radius:6px; padding:4px 11px; font-size:0.76rem; cursor:pointer; color:var(--teal-dark); text-decoration:none; display:inline-block; }
  .view-profile-btn:hover { background:var(--teal); color:#fff; border-color:var(--teal); }
</style>
</head>
<body>

<aside class="sidebar">
  <div class="brand">
    <div class="brand-badge">D4D</div>
    <div class="brand-name">Destined 4<br><span>Destinations</span></div>
  </div>

  <nav class="side-nav">
    <button class="nav-item active" data-panel="dashboard"><span class="icon">&#9679;</span> Dashboard</button>
    <button class="nav-item" data-panel="tasks"><span class="icon">&#10003;</span> Tasks</button>
    <button class="nav-item" data-panel="trips"><span class="icon">&#9992;</span> Trips</button>
    <button class="nav-item" data-panel="clients"><span class="icon">&#128100;</span> Clients</button>
    <button class="nav-item" data-panel="suppliers"><span class="icon">&#127970;</span> Suppliers</button>
    <div class="nav-divider"></div>
    <button class="nav-item" data-panel="reports"><span class="icon">&#128202;</span> Reports</button>
    <button class="nav-item" data-panel="marketing"><span class="icon">&#128227;</span> Marketing</button>
    <button class="nav-item" data-panel="templates"><span class="icon">&#128196;</span> Templates</button>
    <button class="nav-item" data-panel="settings"><span class="icon">&#9881;</span> Settings</button>
  </nav>

  <div class="sidebar-footer">
    <div class="profile-card">
      <div class="profile-avatar">P</div>
      <div>
        <div class="profile-name">Pharin</div>
        <div class="profile-role">Owner &amp; Travel Advisor</div>
      </div>
    </div>
    <a href="entry.html">+ Add / Edit Records</a>
    <a href="#" id="logout-link">Log out</a>
  </div>
</aside>
<div class="sidebar-overlay" id="sidebar-overlay"></div>

<div class="main">

  <div class="topbar">
    <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open menu">&#9776;</button>
    <div>
      <h1 id="page-title">Dashboard</h1>
      <div class="subtitle" id="page-subtitle">Welcome back — here's what's happening.</div>
    </div>
    <div id="conn-indicator" class="status">Not connected</div>
  </div>

  <!-- ============ DASHBOARD ============ -->
  <div class="panel active" id="panel-dashboard">
    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-label">Total Sales (YTD)</div>
        <div class="stat-value" id="stat-sales">—</div>
        <div class="stat-delta neutral" id="stat-sales-delta"></div>
      </div>
      <div class="stat-card">
