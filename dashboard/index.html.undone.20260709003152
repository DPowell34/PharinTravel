  function supplierIcon(type) {
    const icons = {
      'Airline': '&#9992;', 'Hotel': '&#127976;', 'Cruise Line': '&#9973;',
      'Tour Operator': '&#127757;', 'Car Rental': '&#128663;', 'Insurance': '&#128737;',
