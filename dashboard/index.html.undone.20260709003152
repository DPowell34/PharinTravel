<script>
  const els = {
    serverUrl: document.getElementById('server-url'),
    apiKey: document.getElementById('api-key'),
    connectBtn: document.getElementById('connect-btn'),
    connIndicator: document.getElementById('conn-indicator'),
    pageTitle: document.getElementById('page-title'),
    pageSubtitle: document.getElementById('page-subtitle'),
    navItems: document.querySelectorAll('.nav-item[data-panel]'),
    panels: {
      dashboard: document.getElementById('panel-dashboard'),
      tasks: document.getElementById('panel-tasks'),
      trips: document.getElementById('panel-trips'),
      clients: document.getElementById('panel-clients'),
      suppliers: document.getElementById('panel-suppliers'),
      templates: document.getElementById('panel-templates'),
      reports: document.getElementById('panel-reports'),
      marketing: document.getElementById('panel-marketing'),
      settings: document.getElementById('panel-settings'),
    },
    tripsBody: document.getElementById('trips-body'),
    tripsSearch: document.getElementById('trips-search'),
    tripsTypeFilter: document.getElementById('trips-type-filter'),
    tripsStatusFilter: document.getElementById('trips-status-filter'),
    clientsBody: document.getElementById('clients-body'),
    suppliersBody: document.getElementById('suppliers-body'),
    supplierSearch: document.getElementById('supplier-search'),
    supplierTypeFilter: document.getElementById('supplier-type-filter'),
    recentBody: document.getElementById('recent-bookings-body'),
    upcomingList: document.getElementById('upcoming-list'),
    tasksDueList: document.getElementById('tasks-due-list'),
    tasksFullList: document.getElementById('tasks-full-list'),
    tasksConfigNote: document.getElementById('tasks-config-note'),
    taskForm: document.getElementById('task-form'),
    taskTitle: document.getElementById('task-title'),
    taskDue: document.getElementById('task-due'),
    taskRelated: document.getElementById('task-related'),
  };

  const titles = {
    dashboard: ['Dashboard', "Welcome back — here's what's happening."],
    tasks: ['Tasks', 'Everything due or waiting on you.'],
    trips: ['Trips', 'All trips synced from Notion.'],
    clients: ['Clients', 'Your travelers on file.'],
    suppliers: ['Suppliers', 'Hotels, cruise lines, and partners.'],
    templates: ['Templates', 'Ready-to-use content for emails, proposals, invoices, and policies.'],
    reports: ['Reports', 'Sales, commission, trip, client, and supplier reports.'],
    marketing: ['Marketing', 'Client reminders for passports, birthdays, and anniversaries.'],
    settings: ['Settings', 'Connect the dashboard to your server.'],
  };

  let tripsCache = [];
  let tasksCache = [];
  let clientsCache = [];
  let suppliersCache = [];
  let activeTripCategory = '';

  // Remember server URL + key locally (small internal tool; for anything beyond
  // a solo agent, put this behind real auth instead of a shared API key).
  els.apiKey.value = (localStorage.getItem('pharin_api_key') || '').trim();
  // This dashboard is always served from the same origin as its API (see
  // nginx /api/ proxy_pass). Always force this field to the current origin
  // -- never trust a stored or autofilled value -- so devices with a bad
  // cached Server URL (from before this fix existed, or from browser
  // autofill) self-heal automatically instead of failing silently forever.
  els.serverUrl.value = window.location.origin;
  localStorage.setItem('pharin_server_url', els.serverUrl.value);

  function showPanel(name) {
    els.navItems.forEach((n) => n.classList.toggle('active', n.dataset.panel === name));
    Object.entries(els.panels).forEach(([key, el]) => el.classList.toggle('active', key === name));
    const t = titles[name] || ['Dashboard', ''];
    els.pageTitle.textContent = t[0];
    els.pageSubtitle.textContent = t[1];
  }
  els.navItems.forEach((item) => {
    item.addEventListener('click', () => showPanel(item.dataset.panel));
  });
  document.querySelectorAll('[data-panel-link]').forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      showPanel(link.dataset.panelLink);
    });
  });

  function esc(v) {
    if (v === null || v === undefined) return '';
    return String(v).replace(/[&<>"']/g, (c) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[c]));
  }
  function money(n) {
    if (n === null || n === undefined || n === '') return '$0';
    return '$' + Math.round(Number(n)).toLocaleString();
  }
  function statusBadge(status) {
    if (!status) return '';
    const slug = status.toLowerCase().replace(/\s+/g, '-');
    return `<span class="badge ${slug}">${esc(status)}</span>`;
  }
  function fmtDate(d) {
    if (!d) return '';
    const dt = new Date(/^\d{4}-\d{2}-\d{2}$/.test(d) ? d + 'T00:00:00' : d);
    if (isNaN(dt)) return d;
    return dt.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function apiBase() {
    return (els.serverUrl.value.trim() || window.location.origin).replace(/\/$/, '');
  }
  async function apiGet(path) {
    const res = await fetch(apiBase() + path, { headers: { 'X-Api-Key': els.apiKey.value.trim() } });
    if (!res.ok) {
      const text = await res.text().catch(() => '');
      throw new Error(`${res.status} ${res.statusText} ${text}`);
    }
    return res.json();
  }
  async function apiSend(method, path, body) {
    const res = await fetch(apiBase() + path, {
      method,
      headers: { 'Content-Type': 'application/json', 'X-Api-Key': els.apiKey.value.trim() },
      body: JSON.stringify(body || {}),
    });
    if (!res.ok) {
      const text = await res.text().catch(() => '');
      throw new Error(`${res.status} ${res.statusText} ${text}`);
    }
    return res.json();
  }

  // ---------------- Charts ----------------
  let salesChart = null;
  let commissionChart = null;
  const monthLabels = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

  function renderSalesChart(monthlyTotals, year) {
    document.getElementById('sales-chart-year').textContent = year;
    const ctx = document.getElementById('sales-chart').getContext('2d');
    if (salesChart) salesChart.destroy();
    salesChart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: monthLabels,
        datasets: [{
          label: 'Sales',
          data: monthlyTotals,
          borderColor: '#1fa3c9',
          backgroundColor: 'rgba(31,163,201,0.12)',
          fill: true,
          tension: 0.35,
          pointRadius: 3,
        }],
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          y: { ticks: { callback: (v) => '$' + (v >= 1000 ? (v/1000) + 'k' : v) } },
        },
      },
    });
  }

  function renderCommissionChart(buckets) {
    const labels = Object.keys(buckets);
    const values = Object.values(buckets);
    const colors = { Collected: '#16a34a', Expected: '#1fa3c9', 'Past Due': '#dc2626' };
    const total = values.reduce((a, b) => a + b, 0);
    document.getElementById('commission-total').innerHTML = total
      ? `<strong>${money(total)}</strong> total commission`
      : 'No commission data yet.';
    document.getElementById('commission-legend').innerHTML = labels.map((l) => `
      <span><span class="legend-dot" style="background:${colors[l] || '#999'}"></span>${esc(l)} (${money(buckets[l])})</span>
    `).join('');

    const ctx = document.getElementById('commission-chart').getContext('2d');
    if (commissionChart) commissionChart.destroy();
    if (!total) return;
    commissionChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels,
        datasets: [{ data: values, backgroundColor: labels.map((l) => colors[l] || '#999'), borderWidth: 0 }],
      },
      options: { plugins: { legend: { display: false } }, cutout: '65%' },
    });
  }

  // ---------------- Dashboard computation ----------------
  function deltaEl(el, curr, prev, suffix) {
    if (!prev) {
      el.textContent = curr ? 'New activity' + (suffix || '') : '—';
      el.className = 'stat-delta neutral';
      return;
    }
    const pct = ((curr - prev) / prev) * 100;
    const sign = pct >= 0 ? '+' : '';
    el.textContent = `${sign}${pct.toFixed(1)}%${suffix || ' vs last year'}`;
    el.className = 'stat-delta ' + (pct >= 0 ? 'up' : 'down');
  }

  function renderDashboard(trips, tasks) {
    const now = new Date();
    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    const thisYear = now.getFullYear();
    const lastYear = thisYear - 1;
    const weekAgo = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000);

    const yearOf = (d) => (d ? new Date(d).getFullYear() : null);
    const nonCancelled = trips.filter((t) => t.booking_status !== 'Cancelled');
    const thisYearTrips = nonCancelled.filter((t) => yearOf(t.departure_date) === thisYear);
    const lastYearTrips = nonCancelled.filter((t) => yearOf(t.departure_date) === lastYear);
    const sum = (arr, key) => arr.reduce((s, t) => s + (Number(t[key]) || 0), 0);

    const salesYTD = sum(thisYearTrips, 'trip_value');
    const salesLastYear = sum(lastYearTrips, 'trip_value');
    const commissionYTD = sum(thisYearTrips, 'commission');
    const commissionLastYear = sum(lastYearTrips, 'commission');

    document.getElementById('stat-sales').textContent = money(salesYTD);
    document.getElementById('stat-commissions').textContent = money(commissionYTD);
    deltaEl(document.getElementById('stat-sales-delta'), salesYTD, salesLastYear);
    deltaEl(document.getElementById('stat-commissions-delta'), commissionYTD, commissionLastYear);

    const activeStatuses = ['Booked', 'Deposit Paid', 'Paid in Full'];
    const pendingStatuses = ['Inquiry', 'Quoted'];
    const activeTrips = trips.filter((t) => activeStatuses.includes(t.booking_status));
    const pendingQuotes = trips.filter((t) => pendingStatuses.includes(t.booking_status));
    const newActive = activeTrips.filter((t) => t.created_time && new Date(t.created_time) >= weekAgo).length;
    const newPending = pendingQuotes.filter((t) => t.created_time && new Date(t.created_time) >= weekAgo).length;

    document.getElementById('stat-active').textContent = activeTrips.length;
    document.getElementById('stat-pending').textContent = pendingQuotes.length;
    const activeDeltaEl = document.getElementById('stat-active-delta');
    activeDeltaEl.textContent = newActive ? `+${newActive} new this week` : 'No new activity this week';
    activeDeltaEl.className = 'stat-delta ' + (newActive ? 'up' : 'neutral');
    const pendingDeltaEl = document.getElementById('stat-pending-delta');
    pendingDeltaEl.textContent = newPending ? `+${newPending} new this week` : 'No new activity this week';
    pendingDeltaEl.className = 'stat-delta ' + (newPending ? 'up' : 'neutral');

    const monthlyTotals = new Array(12).fill(0);
    thisYearTrips.forEach((t) => {
      if (!t.departure_date) return;
      const m = new Date(t.departure_date).getMonth();
      monthlyTotals[m] += Number(t.trip_value) || 0;
    });
    renderSalesChart(monthlyTotals, thisYear);

    const commissionBuckets = {};
    trips.forEach((t) => {
      const c = Number(t.commission) || 0;
      if (!c) return;
      const status = t.commission_status || 'Expected';
      commissionBuckets[status] = (commissionBuckets[status] || 0) + c;
    });
    renderCommissionChart(commissionBuckets);

    const upcoming = trips
      .filter((t) => t.departure_date && new Date(t.departure_date) >= today && t.booking_status !== 'Cancelled')
      .sort((a, b) => new Date(a.departure_date) - new Date(b.departure_date))
      .slice(0, 5);
    els.upcomingList.innerHTML = upcoming.length ? upcoming.map((t) => {
      const days = Math.round((new Date(t.departure_date) - today) / 86400000);
      return `<li>
        <div>
          <div class="item-main">${esc(t.trip_name || t.destination || 'Trip')}</div>
          <div class="item-sub">${esc(t.client_name || '')}${t.destination ? ' · ' + esc(t.destination) : ''}</div>
        </div>
        <div class="item-meta">${fmtDate(t.departure_date)}<small>in ${days} day${days === 1 ? '' : 's'}</small></div>
      </li>`;
    }).join('') : '<li class="empty">No upcoming departures.</li>';

    const dueTasks = tasks
      .filter((t) => !t.done)
      .sort((a, b) => new Date(a.due_date || '9999-12-31') - new Date(b.due_date || '9999-12-31'))
      .slice(0, 5);
    els.tasksDueList.innerHTML = dueTasks.length ? dueTasks.map((t) => `
      <li>
        <div>
          <div class="item-main">${esc(t.title)}</div>
          <div class="item-sub">${esc(t.related_to || '')}</div>
        </div>
        <div class="item-meta">${t.due_date ? fmtDate(t.due_date) : 'No due date'}</div>
      </li>
    `).join('') : '<li class="empty">No open tasks. Add one from the Tasks tab.</li>';

    const recent = [...trips]
      .sort((a, b) => new Date(b.created_time || 0) - new Date(a.created_time || 0))
      .slice(0, 6);
    els.recentBody.innerHTML = recent.length ? recent.map((t) => `
      <tr>
        <td>${esc(t.client_name)}</td>
        <td>${esc(t.trip_name)}</td>
        <td>${fmtDate(t.departure_date)}</td>
        <td>${money(t.trip_value)}</td>
        <td>${statusBadge(t.booking_status)}</td>
      </tr>
    `).join('') : '<tr><td colspan="5" class="empty-cell">No bookings yet.</td></tr>';
  }

