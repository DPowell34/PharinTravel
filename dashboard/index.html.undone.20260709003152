  function renderSuppliersPanel(trips, suppliers) {
    const totalSalesEl = document.getElementById('sup-total-sales');
    const totalCommEl = document.getElementById('sup-total-commission');
    const totalOutEl = document.getElementById('sup-total-outstanding');
    const activeEl = document.getElementById('sup-active-count');
    if (!suppliers || !suppliers.length) {
      els.suppliersBody.innerHTML = '<tr><td colspan="7" class="empty-cell">No suppliers yet.</td></tr>';
      totalSalesEl.textContent = money(0);
      totalCommEl.textContent = money(0);
      totalOutEl.textContent = money(0);
      activeEl.textContent = '0';
      return;
    }
    const bySupplier = {};
    suppliers.forEach((s) => {
      bySupplier[s.id] = { supplier: s, sales: 0, commission: 0, outstanding: 0, bookings: 0 };
    });
    (trips || []).forEach((t) => {
      if (!t.supplier_id || !bySupplier[t.supplier_id]) return;
      const agg = bySupplier[t.supplier_id];
      agg.sales += Number(t.trip_value) || 0;
      agg.commission += Number(t.commission) || 0;
      agg.bookings += 1;
      if (t.commission_status === 'Past Due') agg.outstanding += Number(t.commission) || 0;
    });

    const search = (els.supplierSearch && els.supplierSearch.value.trim().toLowerCase()) || '';
    const typeFilter = (els.supplierTypeFilter && els.supplierTypeFilter.value) || '';

    let rows = Object.values(bySupplier);
    if (search) {
      rows = rows.filter((r) => (r.supplier.name || '').toLowerCase().includes(search));
    }
    if (typeFilter) {
      rows = rows.filter((r) => r.supplier.supplier_type === typeFilter);
    }
    rows.sort((a, b) => b.sales - a.sales);

    if (!rows.length) {
      els.suppliersBody.innerHTML = '<tr><td colspan="7" class="empty-cell">No suppliers match your search.</td></tr>';
    } else {
      els.suppliersBody.innerHTML = rows.map((r) => {
        const s = r.supplier;
        return `
          <tr>
            <td>
              <div class="sup-row">
                <div class="sup-avatar">${supplierIcon(s.supplier_type)}</div>
                <span class="sup-name">${esc(s.name)}</span>
              </div>
            </td>
            <td>${s.supplier_type ? `<span class="badge cat-${catSlug(s.supplier_type)}">${esc(s.supplier_type)}</span>` : ''}</td>
            <td>${money(r.sales)}</td>
            <td>${money(r.commission)}</td>
            <td>${r.outstanding ? `<span class="sup-outstanding">${money(r.outstanding)}</span>` : money(0)}</td>
            <td>${r.bookings}</td>
            <td><a href="supplier-detail.html?id=${esc(s.id)}" class="link">View</a></td>
          </tr>
        `;
      }).join('');
    }

    const allRows = Object.values(bySupplier);
    const totalSales = allRows.reduce((sum, r) => sum + r.sales, 0);
    const totalCommission = allRows.reduce((sum, r) => sum + r.commission, 0);
    const totalOutstanding = allRows.reduce((sum, r) => sum + r.outstanding, 0);
    totalSalesEl.textContent = money(totalSales);
    totalCommEl.textContent = money(totalCommission);
    totalOutEl.textContent = money(totalOutstanding);
    activeEl.textContent = String(suppliers.length);
  }

