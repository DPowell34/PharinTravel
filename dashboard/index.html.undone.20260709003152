    <div class="profile-modal-head">
      <h3 id="client-profile-name">Client Profile</h3>
      <button class="profile-modal-close" id="client-profile-close" aria-label="Close">&times;</button>
    </div>
    <div id="client-profile-body">Loading&hellip;</div>
  </div>
</div>

