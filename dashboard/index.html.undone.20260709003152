  function rptYearOf(d) {
    return d ? new Date(d).getFullYear() : null;
  }

  const rptYearSelect = document.getElementById('rpt-year');

  function rptPopulateYears(trips) {
    const years = new Set();
    trips.forEach((t) => {
      const y = rptYearOf(t.departure_date);
      if (y) years.add(y);
    });
    const sorted = [...years].sort((a, b) => b - a);
    const current = new Date().getFullYear();
    let options = '<option value="all">All Time</option>';
    sorted.forEach((y) => {
      options += `<option value="${y}">${y}</option>`;
    });
    rptYearSelect.innerHTML = options;
    rptYearSelect.value = sorted.includes(current) ? String(current) : 'all';
  }

  function renderReports(trips) {
    if (!trips || !rptYearSelect) return;
    if (!rptYearSelect.options.length) rptPopulateYears(trips);

    const yearVal = rptYearSelect.value || 'all';
    const nonCancelled = trips.filter((t) => t.booking_status !== 'Cancelled');
    const current = yearVal === 'all' ? nonCancelled : nonCancelled.filter((t) => rptYearOf(t.departure_date) === Number(yearVal));
    const prevYearVal = yearVal === 'all' ? null : Number(yearVal) - 1;
    const previous = prevYearVal ? nonCancelled.filter((t) => rptYearOf(t.departure_date) === prevYearVal) : [];

    const sum = (arr, key) => arr.reduce((s, t) => s + (Number(t[key]) || 0), 0);

    const curSales = sum(current, 'trip_value');
    const curComm = sum(current, 'commission');
    const curTrips = current.length;
    const curAvg = curSales ? (curComm / curSales) * 100 : 0;
    const prevSales = sum(previous, 'trip_value');
    const prevComm = sum(previous, 'commission');
    const prevTrips = previous.length;
    const prevAvg = prevSales ? (prevComm / prevSales) * 100 : 0;

    document.getElementById('rpt-ov-sales').textContent = money(curSales);
    document.getElementById('rpt-ov-commission').textContent = money(curComm);
    document.getElementById('rpt-ov-trips').textContent = curTrips;
    document.getElementById('rpt-ov-avgcomm').textContent = rptPct(curAvg);

    function rptSetDelta(id, curr, prev) {
      const el = document.getElementById(id);
      if (!el) return;
      if (yearVal === 'all' || !prev) {
        el.textContent = '';
        el.className = 'rpt-delta neutral';
        return;
      }
      const pct = prev ? ((curr - prev) / prev) * 100 : 0;
      const sign = pct >= 0 ? '+' : '';
      el.textContent = `${sign}${pct.toFixed(1)}% vs ${prevYearVal}`;
      el.className = 'rpt-delta ' + (pct >= 0 ? 'up' : 'down');
    }
    rptSetDelta('rpt-ov-sales-delta', curSales, prevSales);
    rptSetDelta('rpt-ov-commission-delta', curComm, prevComm);
    rptSetDelta('rpt-ov-trips-delta', curTrips, prevTrips);
    rptSetDelta('rpt-ov-avgcomm-delta', curAvg, prevAvg);

    function rptGroupBy(arr, keyFn, labelFn) {
      const map = new Map();
      arr.forEach((t) => {
        const key = keyFn(t) || 'Unknown';
        if (!map.has(key)) map.set(key, { label: labelFn(t) || key, sales: 0, commission: 0, count: 0 });
        const g = map.get(key);
        g.sales += Number(t.trip_value) || 0;
        g.commission += Number(t.commission) || 0;
        g.count += 1;
      });
      return [...map.values()];
    }

    const byClient = rptGroupBy(current, (t) => t.client_name, (t) => t.client_name).sort((a, b) => b.sales - a.sales);
    const bySupplier = rptGroupBy(current, (t) => t.supplier_name || 'No supplier listed', (t) => t.supplier_name || 'No supplier listed').sort((a, b) => b.sales - a.sales);

    function rptRenderTop(bodyId, rows, n) {
      const body = document.getElementById(bodyId);
      const top = rows.slice(0, n);
      body.innerHTML = top.length ? top.map((r) => `
        <tr><td>${esc(r.label)}</td><td>${money(r.sales)}</td><td>${money(r.commission)}</td><td>${rptPct(r.sales ? (r.commission / r.sales) * 100 : 0)}</td></tr>
      `).join('') : '<tr><td colspan="4" class="empty-cell">No data for this period.</td></tr>';
    }
    rptRenderTop('rpt-top-clients-body', byClient, 10);
    rptRenderTop('rpt-top-suppliers-body', bySupplier, 10);

    document.getElementById('rpt-mo-sales').textContent = money(curSales);
    document.getElementById('rpt-mo-commission').textContent = money(curComm);
    const expected = sum(current.filter((t) => t.commission_status === 'Expected'), 'commission');
    const collected = sum(current.filter((t) => t.commission_status === 'Collected'), 'commission');
    document.getElementById('rpt-mo-expected').textContent = money(expected);
    document.getElementById('rpt-mo-collected').textContent = money(collected);

    const rptMonthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    const monthly = new Map();
    current.forEach((t) => {
      if (!t.departure_date) return;
      const d = new Date(t.departure_date);
      const key = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0');
      if (!monthly.has(key)) {
        monthly.set(key, { label: rptMonthNames[d.getMonth()] + ' ' + d.getFullYear(), sales: 0, commission: 0, expected: 0, collected: 0, sortKey: key });
      }
      const m = monthly.get(key);
      m.sales += Number(t.trip_value) || 0;
      m.commission += Number(t.commission) || 0;
      if (t.commission_status === 'Expected') m.expected += Number(t.commission) || 0;
      if (t.commission_status === 'Collected') m.collected += Number(t.commission) || 0;
    });
    const monthRows = [...monthly.values()].sort((a, b) => b.sortKey.localeCompare(a.sortKey));
    document.getElementById('rpt-monthly-body').innerHTML = monthRows.length ? monthRows.map((m) => `
      <tr><td>${esc(m.label)}</td><td>${money(m.sales)}</td><td>${money(m.commission)}</td><td>${money(m.expected)}</td><td>${money(m.collected)}</td></tr>
    `).join('') : '<tr><td colspan="5" class="empty-cell">No trips with departure dates in this period.</td></tr>';
    rptExportData.monthly = [['Month', 'Total Sales', 'Total Commission', 'Expected', 'Collected']].concat(
      monthRows.map((m) => [m.label, m.sales.toFixed(2), m.commission.toFixed(2), m.expected.toFixed(2), m.collected.toFixed(2)])
    );

    const tripRows = [...current].sort((a, b) => (Number(b.trip_value) || 0) - (Number(a.trip_value) || 0));
    document.getElementById('rpt-trips-body').innerHTML = tripRows.length ? tripRows.map((t) => `
      <tr>
        <td>${esc(t.trip_name)}</td>
        <td>${esc(t.client_name)}</td>
        <td>${fmtDate(t.departure_date)}</td>
        <td>${money(t.trip_value)}</td>
        <td>${money(t.commission)}</td>
        <td>${rptPct(t.trip_value ? (Number(t.commission) / Number(t.trip_value)) * 100 : 0)}</td>
        <td>${statusBadge(t.booking_status)}</td>
      </tr>
    `).join('') : '<tr><td colspan="7" class="empty-cell">No trips for this period.</td></tr>';
    document.getElementById('rpt-trips-total').innerHTML = `<td>TOTAL (${tripRows.length})</td><td></td><td></td><td>${money(curSales)}</td><td>${money(curComm)}</td><td>${rptPct(curAvg)}</td><td></td>`;
    rptExportData.trips = [['Trip', 'Client', 'Departure', 'Total Sales', 'Commission', 'Avg %', 'Status']].concat(
      tripRows.map((t) => [t.trip_name, t.client_name, t.departure_date || '', (Number(t.trip_value) || 0).toFixed(2), (Number(t.commission) || 0).toFixed(2), (t.trip_value ? (Number(t.commission) / Number(t.trip_value)) * 100 : 0).toFixed(2), t.booking_status || ''])
    );

    document.getElementById('rpt-clients-body').innerHTML = byClient.length ? byClient.map((c) => `
      <tr><td>${esc(c.label)}</td><td>${c.count}</td><td>${money(c.sales)}</td><td>${money(c.commission)}</td><td>${rptPct(c.sales ? (c.commission / c.sales) * 100 : 0)}</td></tr>
    `).join('') : '<tr><td colspan="5" class="empty-cell">No clients for this period.</td></tr>';
    document.getElementById('rpt-clients-total').innerHTML = `<td>TOTAL (${byClient.length})</td><td>${curTrips}</td><td>${money(curSales)}</td><td>${money(curComm)}</td><td>${rptPct(curAvg)}</td>`;
    rptExportData.clients = [['Client', 'Trips', 'Total Sales', 'Total Commission', 'Avg Commission %']].concat(
      byClient.map((c) => [c.label, c.count, c.sales.toFixed(2), c.commission.toFixed(2), (c.sales ? (c.commission / c.sales) * 100 : 0).toFixed(2)])
    );

    document.getElementById('rpt-suppliers-body').innerHTML = bySupplier.length ? bySupplier.map((s) => `
      <tr><td>${esc(s.label)}</td><td>${s.count}</td><td>${money(s.sales)}</td><td>${money(s.commission)}</td><td>${rptPct(s.sales ? (s.commission / s.sales) * 100 : 0)}</td></tr>
    `).join('') : '<tr><td colspan="5" class="empty-cell">No suppliers for this period.</td></tr>';
    document.getElementById('rpt-suppliers-total').innerHTML = `<td>TOTAL (${bySupplier.length})</td><td>${curTrips}</td><td>${money(curSales)}</td><td>${money(curComm)}</td><td>${rptPct(curAvg)}</td>`;
    rptExportData.suppliers = [['Supplier', 'Trips', 'Total Sales', 'Total Commission', 'Avg Commission %']].concat(
      bySupplier.map((s) => [s.label, s.count, s.sales.toFixed(2), s.commission.toFixed(2), (s.sales ? (s.commission / s.sales) * 100 : 0).toFixed(2)])
    );
  }

  if (rptYearSelect) {
    rptYearSelect.addEventListener('change', () => renderReports(tripsCache));
  }
  document.querySelectorAll('.nav-item[data-panel="reports"]').forEach((btn) => {
    btn.addEventListener('click', () => renderReports(tripsCache));
  });

  // ---- Marketing panel: Client Reminders ----
  document.querySelectorAll('.mkt-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.mkt;
      document.querySelectorAll('.mkt-tab').forEach((b) => b.classList.toggle('active', b === btn));
      document.querySelectorAll('.mkt-section').forEach((s) => s.classList.toggle('active', s.id === 'mkt-' + target));
    });
  });

  function mktDaysUntil(dateStr) {
    if (!dateStr) return null;
    const target = new Date(dateStr);
    if (isNaN(target)) return null;
    const now = new Date();
    now.setHours(0, 0, 0, 0);
    target.setHours(0, 0, 0, 0);
    return Math.round((target - now) / 86400000);
  }

  function mktTimeLeftLabel(days) {
    if (days === null) return '';
    if (days < 0) return Math.abs(days) + ' day' + (Math.abs(days) === 1 ? '' : 's') + ' ago';
    if (days === 0) return 'Today';
    if (days < 60) return days + ' day' + (days === 1 ? '' : 's');
    const months = Math.round(days / 30);
    return months + ' month' + (months === 1 ? '' : 's');
  }

  function mktStatusBadge(days) {
    if (days === null) return '';
    if (days < 0) return '<span class="badge mkt-expired">Expired</span>';
    if (days <= 180) return '<span class="badge mkt-soon">Expiring Soon</span>';
    return '<span class="badge mkt-ok">OK</span>';
  }

  let mktPassportRows = [];

  function mktNextOccurrence(dateStr) {
    if (!dateStr) return null;
    const orig = new Date(dateStr);
    if (isNaN(orig)) return null;
    const now = new Date();
    now.setHours(0, 0, 0, 0);
    let next = new Date(now.getFullYear(), orig.getMonth(), orig.getDate());
    next.setHours(0, 0, 0, 0);
    if (next < now) next = new Date(now.getFullYear() + 1, orig.getMonth(), orig.getDate());
    const days = Math.round((next - now) / 86400000);
    const years = next.getFullYear() - orig.getFullYear();
    return { days, years };
  }

  function mktWhenLabel(days) {
    if (days === null || days === undefined) return '';
    if (days === 0) return 'Today';
    if (days === 1) return 'Tomorrow';
    if (days < 30) return 'in ' + days + ' days';
    const months = Math.round(days / 30);
    return 'in ' + months + ' month' + (months === 1 ? '' : 's');
  }

  function renderMarketing(clients) {
    const list = clients || [];

    const withPassport = list
      .filter((c) => c.passport_expiry)
      .map((c) => Object.assign({}, c, { days: mktDaysUntil(c.passport_expiry) }))
      .sort((a, b) => (a.days === null ? Infinity : a.days) - (b.days === null ? Infinity : b.days));

    mktPassportRows = withPassport;
    const searchEl = document.getElementById('mkt-search');
    mktRenderPassportTable(searchEl ? searchEl.value.trim().toLowerCase() : '');

    rptExportData.passports = [
      ['Client', 'Email', 'Phone', 'Passport Expires', 'Days Until Expiry'],
    ].concat(withPassport.map((c) => [c.name, c.email, c.phone, c.passport_expiry, c.days]));

    const withBirthday = list
      .filter((c) => c.date_of_birth)
      .map((c) => Object.assign({}, c, mktNextOccurrence(c.date_of_birth)))
      .sort((a, b) => a.days - b.days);
    const bdayBody = document.getElementById('mkt-birthdays-body');
    if (bdayBody) {
      bdayBody.innerHTML = withBirthday.length
        ? withBirthday.map((c) => `
            <tr>
              <td>${esc(c.name)}</td>
              <td>${esc(c.email)}</td>
              <td>${esc(c.phone)}</td>
              <td>${fmtDate(c.date_of_birth)}</td>
              <td>${c.years} years old</td>
              <td>${mktWhenLabel(c.days)}</td>
            </tr>
          `).join('')
        : '<tr><td colspan="6" class="empty-cell">No clients with a date of birth on file yet.</td></tr>';
    }
    rptExportData.birthdays = [
      ['Client', 'Email', 'Phone', 'Birthday', 'Turns', 'Days Until'],
    ].concat(withBirthday.map((c) => [c.name, c.email, c.phone, c.date_of_birth, c.years, c.days]));

    const withAnniversary = list
      .filter((c) => c.anniversary)
      .map((c) => Object.assign({}, c, mktNextOccurrence(c.anniversary)))
      .sort((a, b) => a.days - b.days);
    const annivBody = document.getElementById('mkt-anniversaries-body');
    if (annivBody) {
      annivBody.innerHTML = withAnniversary.length
        ? withAnniversary.map((c) => `
            <tr>
              <td>${esc(c.name)}</td>
              <td>${esc(c.email)}</td>
              <td>${esc(c.phone)}</td>
              <td>${fmtDate(c.anniversary)}</td>
              <td>${c.years} years</td>
              <td>${mktWhenLabel(c.days)}</td>
            </tr>
          `).join('')
        : '<tr><td colspan="6" class="empty-cell">No clients with an anniversary date on file yet.</td></tr>';
    }
    rptExportData.anniversaries = [
      ['Client', 'Email', 'Phone', 'Anniversary', 'Years', 'Days Until'],
    ].concat(withAnniversary.map((c) => [c.name, c.email, c.phone, c.anniversary, c.years, c.days]));

    renderMktCalendar(list);
  }

  function renderMktCalendar(clients) {
    const grid = document.getElementById('mkt-calendar-grid');
    if (!grid) return;
    const list = clients || [];

    const today = new Date();
    today.setHours(0, 0, 0, 0);

    const days = [];
    for (let i = 0; i < 30; i++) {
      const d = new Date(today);
      d.setDate(d.getDate() + i);
      days.push({ date: d, events: [] });
    }

    const addEvents = (dateField, type) => {
      list.filter((c) => c[dateField]).forEach((c) => {
        const occ = mktNextOccurrence(c[dateField]);
        if (occ && occ.days >= 0 && occ.days < 30) {
          days[occ.days].events.push({ type, name: c.name, years: occ.years });
        }
      });
    };
    addEvents('date_of_birth', 'bday');
    addEvents('anniversary', 'anniv');

    const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
    const weekdayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

    grid.innerHTML = days.map((day, i) => {
      const label = weekdayNames[day.date.getDay()] + ', ' + monthNames[day.date.getMonth()] + ' ' + day.date.getDate();
      const events = day.events.map((e) => {
        const cls = e.type === 'bday' ? 'cal-bday' : 'cal-anniv';
        const detail = e.type === 'bday' ? ('turns ' + e.years) : (e.years + ' yr anniversary');
        return `<div class="cal-event ${cls}" title="${esc(e.name)} \u2013 ${detail}">${esc(e.name)}</div>`;
      }).join('');
      return `
        <div class="cal-cell${i === 0 ? ' today' : ''}">
          <div class="cal-date">${label}</div>
          ${events}
        </div>
      `;
    }).join('');
  }

  function mktRenderPassportTable(filter) {
    const body = document.getElementById('mkt-passports-body');
    if (!body) return;
    const rows = filter
      ? mktPassportRows.filter((c) => (c.name || '').toLowerCase().includes(filter) || (c.email || '').toLowerCase().includes(filter))
      : mktPassportRows;
    if (!rows.length) {
      body.innerHTML = `<tr><td colspan="6" class="empty-cell">${mktPassportRows.length ? 'No matches.' : 'No clients with a passport expiration date on file yet.'}</td></tr>`;
      return;
    }
    body.innerHTML = rows.map((c) => `
      <tr>
        <td>${esc(c.name)}</td>
        <td>${esc(c.email)}</td>
        <td>${esc(c.phone)}</td>
        <td>${fmtDate(c.passport_expiry)}</td>
        <td>${mktTimeLeftLabel(c.days)}</td>
        <td>${mktStatusBadge(c.days)}</td>
      </tr>
    `).join('');
  }

  const mktSearchInput = document.getElementById('mkt-search');
  if (mktSearchInput) {
    mktSearchInput.addEventListener('input', () => mktRenderPassportTable(mktSearchInput.value.trim().toLowerCase()));
  }

  document.querySelectorAll('.nav-item[data-panel="marketing"]').forEach((btn) => {
    btn.addEventListener('click', () => renderMarketing(clientsCache));
  });

  if (els.tripsSearch) els.tripsSearch.addEventListener('input', renderTripsTable);
  if (els.tripsTypeFilter) els.tripsTypeFilter.addEventListener('change', renderTripsTable);
  if (els.tripsStatusFilter) els.tripsStatusFilter.addEventListener('change', renderTripsTable);
  if (els.supplierSearch) els.supplierSearch.addEventListener('input', () => renderSuppliersPanel(tripsCache, suppliersCache));
  if (els.supplierTypeFilter) els.supplierTypeFilter.addEventListener('change', () => renderSuppliersPanel(tripsCache, suppliersCache));
  document.querySelectorAll('#trip-cat-filters .cat-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      activeTripCategory = chip.dataset.cat;
      document.querySelectorAll('#trip-cat-filters .cat-chip').forEach((c) => c.classList.toggle('active', c === chip));
      renderTripsTable();
    });
  });

  // ---- Mobile sidebar toggle ----
  (function () {
    const btn = document.getElementById('mobile-menu-btn');
    const overlay = document.getElementById('sidebar-overlay');
    const sidebarEl = document.querySelector('.sidebar');
    if (!btn || !overlay || !sidebarEl) return;
    function closeSidebar() {
      sidebarEl.classList.remove('open');
      overlay.classList.remove('show');
    }
    function toggleSidebar() {
      sidebarEl.classList.toggle('open');
      overlay.classList.toggle('show');
    }
    btn.addEventListener('click', toggleSidebar);
    overlay.addEventListener('click', closeSidebar);
    document.querySelectorAll('.nav-item[data-panel]').forEach((item) => {
      item.addEventListener('click', closeSidebar);
    });
  })();

  async function openClientProfile(id) {
    const overlay = document.getElementById('client-profile-overlay');
    const body = document.getElementById('client-profile-body');
    const nameEl = document.getElementById('client-profile-name');
    if (!overlay || !body) return;
    nameEl.textContent = 'Client Profile';
    body.innerHTML = 'Loading…';
    overlay.classList.add('show');
    try {
      const { client } = await apiGet('/api/clients/' + id);
      nameEl.textContent = client.name || 'Client Profile';
      const rows = [
        ['Email', client.email],
        ['Phone', client.phone],
        ['Date of Birth', client.date_of_birth ? fmtDate(client.date_of_birth) : null],
        ['Anniversary', client.anniversary ? fmtDate(client.anniversary) : null],
        ['Passport Number', client.passport_number],
        ['Passport Country', client.passport_country],
        ['Passport Expiry', client.passport_expiry ? fmtDate(client.passport_expiry) : null],
        ['Frequent Flyer #', client.frequent_flyer_numbers],
        ['Seat Preference', client.seat_preference],
        ['Dietary Restrictions', client.dietary_restrictions],
        ['Emergency Contact', client.emergency_contact],
        ['Referral Source', client.referral_source],
        ['TravelJoy Client ID', client.travel_joy_client_id],
        ['Notes', client.notes],
      ].filter(([, v]) => v);
      body.innerHTML = rows.length ? rows.map(([label, value]) => `
        <div class="profile-modal-row"><span class="label">${esc(label)}</span><span class="value">${esc(value)}</span></div>
      `).join('') : '<div class="profile-modal-row"><span class="label">No additional profile details on file.</span></div>';
    } catch (err) {
      body.innerHTML = `<div class="profile-modal-row"><span class="label">Failed to load profile: ${esc(err.message)}</span></div>`;
    }
  }
  function closeClientProfile() {
    const overlay = document.getElementById('client-profile-overlay');
    if (overlay) overlay.classList.remove('show');
  }
  document.addEventListener('click', (e) => {
    const viewBtn = e.target.closest('.view-profile-btn');
    if (viewBtn && viewBtn.dataset.clientId) {
      openClientProfile(viewBtn.dataset.clientId);
      return;
    }
    if (e.target.id === 'client-profile-close' || e.target.id === 'client-profile-overlay') {
      closeClientProfile();
    }
  });
</script>

<div class="profile-modal-overlay" id="client-profile-overlay">
